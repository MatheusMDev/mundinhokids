# Copie este arquivo para .env.local e preencha com os dados do projeto Supabase.
# O .env.local não vai para o Git.

# Project Settings → API → Project URL
VITE_SUPABASE_URL=https://<id-do-projeto>.supabase.co

# Project Settings → API Keys → chave "anon public" (eyJ...) ou "publishable" (sb_publishable_...).
# Nunca coloque aqui a service_role / secret: tudo que começa com VITE_ vai para o navegador.
VITE_SUPABASE_ANON_KEY=

# Opcional: chave pública VAPID para o alerta de notificações no navegador.
# Sem ela, os avisos continuam aparecendo na tela Notificações.
VITE_VAPID_PUBLIC_KEY=
