# Mundinho Kids — regras do servidor da Hostinger (Apache/LiteSpeed).
# Fica em public/ para o Vite copiar para a dist e o deploy automático sempre enviá-lo.

# Sempre https (login e notificações no celular exigem)
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Arquivo ou pasta que existe (assets, sw.js, logo.png) é entregue direto
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Qualquer outra rota (/eventos/123, /minha-agenda...) abre o app
RewriteRule ^ index.html [L]
